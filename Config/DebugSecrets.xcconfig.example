// Copy this file to DebugSecrets.xcconfig. The real file is gitignored.
// Demo-only: values are compiled into the debug app and can be extracted.
OPENAI_API_KEY = REPLACE_WITH_OPENAI_API_KEY
SHISA_API_KEY = REPLACE_WITH_SHISA_API_KEY
NEO4J_HOST = your-instance.databases.neo4j.io
NEO4J_USERNAME = REPLACE_WITH_DEMO_USERNAME
NEO4J_PASSWORD = REPLACE_WITH_DEMO_PASSWORD
NEO4J_DATABASE = neo4j
