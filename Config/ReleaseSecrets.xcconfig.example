// Copy to ReleaseSecrets.xcconfig only for the short-lived TestFlight demo.
// The copied file is ignored by Git, but all values are extractable from the app.
OPENAI_API_KEY = REPLACE_WITH_OPENAI_API_KEY
SHISA_API_KEY = REPLACE_WITH_SHISA_API_KEY
NEO4J_HOST = replace-me.databases.neo4j.io
NEO4J_USERNAME = REPLACE_WITH_DEMO_USERNAME
NEO4J_PASSWORD = REPLACE_WITH_DEMO_PASSWORD
NEO4J_DATABASE = neo4j
